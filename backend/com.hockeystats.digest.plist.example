<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Morning roster email. To use it:
    1. Copy this file to ~/Library/LaunchAgents/com.hockeystats.digest.plist (keep the copy out of git: it holds a password).
    2. Replace every REPLACE_ME below. SMTP_* are your email provider's settings (Resend, SES, Gmail app password...);
       PUBLIC_URL is the site's address, used for the "turn this off" link.
    3. Fix the script path if the project lives somewhere else.
    4. launchctl load ~/Library/LaunchAgents/com.hockeystats.digest.plist
  Test first with:  cd backend && .venv/bin/python digest.py with the dry-run flag (see README)
  Output goes to backend/logs/digest.log. The Mac must be awake at the scheduled time (launchd runs a missed job at the next wake).
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.hockeystats.digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/calebwallin/code/dixie tech/vibecoding/hockey_stats/backend/run_digest.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>SMTP_HOST</key><string>REPLACE_ME</string>
    <key>SMTP_PORT</key><string>587</string>
    <key>SMTP_USER</key><string>REPLACE_ME</string>
    <key>SMTP_PASSWORD</key><string>REPLACE_ME</string>
    <key>SMTP_FROM</key><string>NHL Stats &lt;REPLACE_ME@example.com&gt;</string>
    <key>PUBLIC_URL</key><string>REPLACE_ME</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>8</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardErrorPath</key><string>/Users/calebwallin/code/dixie tech/vibecoding/hockey_stats/backend/logs/launchd-digest.err</string>
</dict>
</plist>
